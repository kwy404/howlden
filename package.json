{
  "name": "howlden",
  "version": "0.1.1",
  "private": true,
  "description": "Serverless peer to peer group chat, voice and video in the browser. Create a den, share an invite link or QR code and talk over encrypted WebRTC with no accounts, no sign up and no server.",
  "keywords": [
    "p2p chat",
    "peer to peer chat",
    "serverless chat",
    "webrtc chat",
    "webrtc voice chat",
    "webrtc video call",
    "voice chat in browser",
    "screen share in browser",
    "end to end encrypted chat",
    "chat without sign up",
    "pwa chat",
    "qr code invite"
  ],
  "homepage": "https://kwy404.github.io/howlden/",
  "bugs": {
    "url": "https://github.com/kwy404/howlden/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kwy404/howlden.git"
  },
  "license": "MIT",
  "author": "Alexandre Kohler (https://github.com/kwy404)",
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "lint": "eslint .",
    "rules": "node scripts/check-rules.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "core": "node scripts/sync-core.mjs",
    "core:check": "node scripts/sync-core.mjs --check",
    "e2e": "node test/app-e2e.mjs",
    "serve": "node scripts/serve.mjs",
    "site": "node scripts/site/build-site.mjs",
    "site:check": "node scripts/site/build-site.mjs --check && node scripts/site/check-links.mjs",
    "site:images": "node scripts/site/render-images.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@scure/bip39": "^2.4.0",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "jsdom": "^26.1.0",
    "jsqr": "^1.4.0",
    "playwright-core": "1.62.1",
    "vitest": "^3.2.7"
  }
}
